# Portfolio databases — MUST never be committed.
# GitHub Pages only serves public repos, so anything committed here is public.
# The site reads the database from a local file picker at runtime instead.
*.db
*.duckdb
*.db.wal
*.duckdb.wal
*.wal

# Local Google Drive identifiers. Not secrets — they ship in the bundle either
# way — but they are kept out of the repository, so only .env.example is tracked.
.env
.env.local

node_modules/
dist/
.DS_Store
